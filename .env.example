VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Synthetic preview is an explicit, isolated route; never used as a data fallback.
VITE_ENABLE_PREVIEW=false

# Server-only Jira credentials for the authenticated Supabase Edge Function.
# Set these in the Supabase function runtime; never prefix them with VITE_.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-work-email@example.com
JIRA_API_TOKEN=replace-with-your-atlassian-api-token
APP_ORIGIN=http://127.0.0.1:5174
